<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="google-site-verification" content="m6xDqYvIIXt8gOWpsgDxRx-idg-DqqrTiyjvyy1Mf8E">
    <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Sacramento&display=swap" rel="stylesheet">
    <script>window.PP_WATER={{ 'pp-water.jpg' | asset_url | json }};</script>
    <script>
      /* same light as the home page: night 10pm-4am, sunset 4-10 (am and pm), otherwise day, unless a sky was chosen there */
      (function(){var d=document.documentElement,t='day',sky='auto',th='';try{sky=localStorage.getItem('pp-sky')||'auto';th=localStorage.getItem('pp-theme')||'';}catch(e){}
        if(sky==='auto'){var h=new Date().getHours();t=(h>=22||h<4)?'night':(h<10||h>=16)?'sunset':'day';}else if(sky==='sunset')t='sunset';else if(th==='night')t='night';
        d.dataset.tone=t;try{if(sessionStorage.getItem('pp-zoom')){d.classList.add('zin');sessionStorage.removeItem('pp-zoom');}}catch(e){}})();
    </script>
    {{ 'pp-pond.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body data-page="{{ page.handle }}">
    <canvas id="pond" aria-hidden="true"></canvas>
    <div class="pp-veil" aria-hidden="true"></div>
    <header class="pp-top">
      <a class="pp-logo" href="{{ routes.root_url }}" aria-label="Pink Plume home"><img class="td" src="{{ 'pp-logo-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-logo-sunset.png' | asset_url }}" alt=""></a>
      <div class="pp-btns">
        <button class="icon-btn" id="ppTheme" type="button" aria-label="Time of day"><img class="td" src="{{ 'pp-theme-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-theme-sunset.png' | asset_url }}" alt=""></button>
        <button class="icon-btn" id="ppMenu" type="button" aria-label="Open menu"><img class="td" src="{{ 'pp-menu-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-menu-sunset.png' | asset_url }}" alt=""></button>
      </div>
    </header>
    <main class="pp-wrap" id="MainContent">
      {{ content_for_layout }}
    </main>
    <footer class="pp-foot">
      <a class="ft" href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" aria-label="Terms and policies"><img class="td" src="{{ 'pp-f-terms-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-terms-sunset.png' | asset_url }}" alt=""></a>
      <nav class="social" aria-label="Social media">
        <a href="https://www.instagram.com/pinkplumestudio/" target="_blank" rel="noopener" aria-label="Instagram"><img class="td" src="{{ 'pp-f-instagram-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-instagram-sunset.png' | asset_url }}" alt=""></a>
        <a href="https://www.youtube.com/@PinkPlumeStudio" target="_blank" rel="noopener" aria-label="YouTube"><img class="td" src="{{ 'pp-f-youtube-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-youtube-sunset.png' | asset_url }}" alt=""></a>
        <a href="https://www.tiktok.com/@pinkplumestudio" target="_blank" rel="noopener" aria-label="TikTok"><img class="td" src="{{ 'pp-f-tiktok-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-tiktok-sunset.png' | asset_url }}" alt=""></a>
        <a href="https://ca.pinterest.com/pinkplumestudio/" target="_blank" rel="noopener" aria-label="Pinterest"><img class="td" src="{{ 'pp-f-pinterest-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-pinterest-sunset.png' | asset_url }}" alt=""></a>
      </nav>
      <p class="ft" aria-label="© {{ 'now' | date: '%Y' }} Pink Plume"><img class="td" src="{{ 'pp-f-copy-day.png' | asset_url }}" alt=""><img class="ts" src="{{ 'pp-f-copy-sunset.png' | asset_url }}" alt=""></p>
    </footer>
    <script src="{{ 'pp-pond.js' | asset_url }}" defer></script>
  </body>
</html>
