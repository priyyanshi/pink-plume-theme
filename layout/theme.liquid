<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
  <meta name="google-site-verification" content="m6xDqYvIIXt8gOWpsgDxRx-idg-DqqrTiyjvyy1Mf8E" />  
  <style>
    body {
      background: #28090a;
      opacity: 0;
      animation: site-fade-in 0.4s ease 0.1s forwards;
    }

    @keyframes site-fade-in {
      to { opacity: 1; }
    }

    #header-group {
      position: relative;
      z-index: 3000;
      animation: header-drop-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }

    .header-section {
      z-index: 3000 !important;
    }

    #top-gradient {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 250px;
      background: linear-gradient(to bottom, rgba(21, 4, 4, 1) 0%, rgba(84,12,21,0.1) 40%, rgba(0,0,0,0) 100%);
      z-index: 2999;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      #top-gradient {
        position: absolute;
      }

      body {
        animation: site-fade-in 0.2s ease 0s forwards;
      }

      #header-group {
        animation: header-drop-in 0.2s ease 0s both;
      }

      #MainContent {
        animation: content-fade-in 0.2s ease 0s both;
      }
    }

    @keyframes header-drop-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    #MainContent {
      min-height: 100svh;
      animation: content-fade-in 0.4s ease 0.2s both;
    }

    @keyframes content-fade-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    footer.section-wrapper {
      position: relative;
      z-index: 600;
    }

    @media screen and (orientation: landscape) and (max-height: 500px) {
      #top-gradient {
        position: absolute;
      }

      #MainContent {
        position: relative;
        z-index: 2;
      }
    }

    footer.section-wrapper .section {
      padding-block-start: 0 !important;
      padding-block-end: 0 !important;
    }

    .footer-content {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: wrap;
      align-items: center !important;
      justify-content: center !important;
      gap: 6px 20px !important;
      margin-left: 0 !important;
      padding-inline: 10px !important;
    }

    footer.section-wrapper .footer-utilities__text,
    footer.section-wrapper .footer-utilities__text a,
    footer.section-wrapper .social-icons__wrapper a,
    footer.section-wrapper .social-icons__icon,
    footer.section-wrapper a,
    footer.section-wrapper p,
    footer.section-wrapper span,
    footer.section-wrapper svg {
      color: rgba(229, 214, 200, 0.4) !important;
      fill: rgba(229, 214, 200, 0.4) !important;
    }

    footer.section-wrapper .footer-utilities__text,
    footer.section-wrapper .policy-list-trigger {
      font-size: 0.875rem !important;
      text-transform: uppercase !important;
      letter-spacing: 0.05em !important;
    }

    @media screen and (max-width: 749px),
    screen and (orientation: landscape) and (max-height: 500px) {
      footer.section-wrapper,
      footer.section-wrapper .section,
      footer.section-wrapper .spacing-style {
        padding-block-start: 6px !important;
        padding-block-end: 6px !important;
        min-height: unset !important;
      }

      .footer-content {
        flex-wrap: nowrap !important;
        gap: 4px 18px !important;
      }

      footer.section-wrapper .layout-panel-flex {
        flex-wrap: nowrap !important;
        gap: 4px 16px !important;
        padding: 0 !important;
      }

      footer.section-wrapper .footer-utilities__text,
      footer.section-wrapper .footer-utilities__text a,
      footer.section-wrapper .policy-list-trigger,
      footer.section-wrapper a,
      footer.section-wrapper p,
      footer.section-wrapper span {
        font-size: 0.6rem !important;
        line-height: 1 !important;
        color: rgba(229, 214, 200, 0.4) !important;
        fill: rgba(229, 214, 200, 0.4) !important;
      }

      footer.section-wrapper .social-icons__wrapper {
        flex-wrap: nowrap !important;
        gap: 10px !important;
      }

      footer.section-wrapper .social-icons__icon,
      footer.section-wrapper .social-icons__wrapper svg,
      footer.section-wrapper .social-icons__wrapper a svg {
        width: 22px !important;
        height: 22px !important;
        color: rgba(229, 214, 200, 0.4) !important;
        fill: rgba(229, 214, 200, 0.4) !important;
      }
    }
  </style>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}


    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {% if template == 'index' and settings.homepage_video_url != blank %}
      <link rel="preload" as="video" href="{{ settings.homepage_video_url }}" type="video/mp4">
    {% endif %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {% section 'custom-font' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>
    <div id="top-gradient"></div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <script src="{{ 'page-transitions.js' | asset_url }}" type="module"></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% section 'page-transitions-config' %}
  </body>
</html>
