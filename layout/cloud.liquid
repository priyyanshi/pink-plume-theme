    <style>
      /* the very first colour, so the browser never flashes white (or keeps the last page's colour) at the bottom */
      html{background-color:#232c18}html[data-pt=sunset]{background-color:#3e2222}html[data-pt=night]{background-color:#10120c}
      /* shown the instant the page starts, until the sky has loaded and the cloud is ready to puff in */
      #ppLoad{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;overflow:hidden;background:linear-gradient(#ae9fd0 0%,#e8bcd6 36%,#d2c4e2 56%,#93a27e 76%,#4f6742 100%);transition:opacity 1s ease,visibility 1s}
      #ppLoad[data-t=sunset]{background:linear-gradient(#6a3262 0%,#d9606c 34%,#ffb08c 54%,#9a7650 76%,#4a3d2c 100%)}
      #ppLoad[data-t=night]{background:linear-gradient(#120d2c 0%,#2a1f55 40%,#3d2c66 58%,#1f2a20 78%,#0d1209 100%)}
      #ppLoad.gone{opacity:0;visibility:hidden;pointer-events:none}
      #ppLoad i{position:absolute;border-radius:50%;background:rgba(255,255,255,.55);filter:blur(34px);animation:ppDrift 14s ease-in-out infinite alternate}
      #ppLoad[data-t=sunset] i{background:rgba(255,205,180,.5)}#ppLoad[data-t=night] i{background:rgba(150,110,210,.28)}
      #ppLoad i:nth-child(1){width:46vmax;height:16vmax;left:-8vmax;top:14%}
      #ppLoad i:nth-child(2){width:40vmax;height:14vmax;right:-10vmax;top:50%;animation-delay:-5s;animation-duration:17s}
      #ppLoad i:nth-child(3){width:34vmax;height:12vmax;left:18%;bottom:6%;animation-delay:-9s}
      #ppLoad .plw{position:relative;width:clamp(130px,24vw,210px);height:auto;overflow:visible;animation:ppPulse 2.4s ease-in-out infinite;filter:drop-shadow(0 0 8px rgba(255,150,200,.8)) drop-shadow(0 0 22px rgba(255,150,200,.45))}
      #ppLoad .plw path{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:11 6.5}
      #ppLoad .plw .a{stroke:#ff6fa6;stroke-width:5.4}#ppLoad .plw .b{stroke:#ffd5e6;stroke-width:2;stroke-dasharray:6 11.5;stroke-dashoffset:-2.5}
      #ppLoad[data-t=night] .plw .a{stroke:#ff86b8}
      @keyframes ppDrift{to{transform:translateX(9vmax)}}
      @keyframes ppPulse{50%{opacity:.62;transform:scale(.985)}}
      @media (prefers-reduced-motion:reduce){#ppLoad i,#ppLoad .plw{animation:none}}
    </style>
