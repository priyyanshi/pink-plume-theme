{%- if paginate.pages > 1 -%}
<nav class="pp-pager" aria-label="Pagination">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; back</a>{%- endif -%}
  <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}">more &rarr;</a>{%- endif -%}
</nav>
{%- endif -%}
