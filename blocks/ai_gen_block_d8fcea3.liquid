{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign block_settings = block.settings %}

{% style %}
  .ai-overlay-slideshow-{{ ai_gen_id }} {
    position: absolute;
    z-index: {{ block_settings.z_index }};
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .ai-overlay-slideshow-container-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block_settings.width }}%;
    height: {{ block_settings.height }}%;
    pointer-events: auto;
    
    /* Desktop positioning - use exact pixel offsets for precision */
    {% if block_settings.position_mode == 'alignment' %}
      /* Alignment-based positioning */
      {% if block_settings.horizontal_alignment == 'left' %}
        left: {{ block_settings.offset_left }}%;
        right: auto;
      {% elsif block_settings.horizontal_alignment == 'center' %}
        left: 50%;
        transform: translateX(calc(-50% + {{ block_settings.offset_horizontal }}%));
        right: auto;
      {% elsif block_settings.horizontal_alignment == 'right' %}
        right: {{ block_settings.offset_right }}%;
        left: auto;
      {% endif %}
      
      {% if block_settings.vertical_alignment == 'top' %}
        top: {{ block_settings.offset_top }}%;
        bottom: auto;
      {% elsif block_settings.vertical_alignment == 'middle' %}
        top: 50%;
        {% if block_settings.horizontal_alignment == 'center' %}
          transform: translate(calc(-50% + {{ block_settings.offset_horizontal }}%), calc(-50% + {{ block_settings.offset_vertical }}%));
        {% else %}
          transform: translateY(calc(-50% + {{ block_settings.offset_vertical }}%));
        {% endif %}
        bottom: auto;
      {% elsif block_settings.vertical_alignment == 'bottom' %}
        bottom: {{ block_settings.offset_bottom }}%;
        top: auto;
      {% endif %}
    {% else %}
      /* Manual positioning - precise control */
      left: {{ block_settings.manual_left }}%;
      top: {{ block_settings.manual_top }}%;
    {% endif %}
  }

  .ai-overlay-slideshow-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: {{ block_settings.transition_background_color | default: '#000000' }};
    border-radius: {{ block_settings.border_radius }}px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 65%, transparent 95%);
    mask-image: radial-gradient(ellipse at 50% 50%, black 65%, transparent 95%);
    {% if block_settings.maintain_aspect_ratio %}
      aspect-ratio: {{ block_settings.aspect_ratio_width }} / {{ block_settings.aspect_ratio_height }};
    {% endif %}
  }

  .ai-overlay-slideshow-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-overlay-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block_settings.transition_speed }}s ease-in-out;
  }

  .ai-overlay-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    position: relative;
  }

  .ai-overlay-slideshow-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-overlay-slideshow-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ block_settings.image_fit }};
  }

  .ai-overlay-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-overlay-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-overlay-slideshow-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      transparent {{ block_settings.gradient_center_size }}%,
      {{ block_settings.border_gradient_color }} 100%
    );
    opacity: {{ block_settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-overlay-slideshow-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block_settings.content_vertical_alignment }};
    align-items: {{ block_settings.content_horizontal_alignment }};
    text-align: {{ block_settings.text_alignment }};
    padding: 5%;
    z-index: 2;
    box-sizing: border-box;
  }

  .ai-overlay-slideshow-text-wrapper-{{ ai_gen_id }} {
    max-width: 90%;
  }

  .ai-overlay-slideshow-heading-{{ ai_gen_id }} {
    margin: 0 0 0.5em;
    font-size: clamp(16px, {{ block_settings.heading_size }}px, 4vw);
    color: {{ block_settings.text_color }};
    line-height: 1.2;
    text-transform: none;
  }

  .ai-overlay-slideshow-description-{{ ai_gen_id }} {
    margin: 0 0 1em;
    font-size: clamp(12px, {{ block_settings.description_size }}px, 3vw);
    color: {{ block_settings.text_color }};
  }

  .ai-overlay-slideshow-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: clamp(8px, 1.5vw, 12px) clamp(16px, 3vw, 24px);
    background-color: {{ block_settings.button_hover_background | color_modify: 'alpha', 0.0 }};
    color: {{ block_settings.button_text_color | color_modify: 'alpha', 0.5 }};
    text-decoration: none;
    border-radius: {{ block_settings.button_border_radius }}px;
    transition: background-color 0.3s ease;
    font-size: clamp(12px, 1.5vw, 16px);
  }

  .ai-overlay-slideshow-button-{{ ai_gen_id }}:hover {
    background-color: {{ block_settings.button_hover_background | color_modify: 'alpha', 0.0  }};
  }

  .ai-overlay-slideshow-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-overlay-slideshow-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block_settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s ease;
    border: none;
    padding: 0;
  }

  .ai-overlay-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-overlay-slideshow-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    z-index: 3;
    pointer-events: none;
    padding: 0 2%;
  }

  .ai-overlay-slideshow-arrow-{{ ai_gen_id }} {
    background-color: {{ block_settings.arrow_background }};
    color: {{ block_settings.arrow_color }};
    border: none;
    width: clamp(30px, 5vw, 40px);
    height: clamp(30px, 5vw, 40px);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    pointer-events: auto;
  }

  .ai-overlay-slideshow-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block_settings.arrow_hover_background }};
  }

  .ai-overlay-slideshow-arrow-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-overlay-slideshow-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  /* Mobile responsive styles */
  @media screen and (max-width: 749px) {
    .ai-overlay-slideshow-container-{{ ai_gen_id }} {
      width: {{ block_settings.mobile_width }}%;
      height: {{ block_settings.mobile_height }}%;
      
      /* Reset desktop positioning */
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      transform: none !important;
      
      /* Mobile positioning */
      {% if block_settings.mobile_position_mode == 'alignment' %}
        /* Alignment-based positioning for mobile */
        {% if block_settings.mobile_horizontal_alignment == 'left' %}
          left: {{ block_settings.mobile_offset_left }}% !important;
        {% elsif block_settings.mobile_horizontal_alignment == 'center' %}
          left: 50% !important;
          transform: translateX(calc(-50% + {{ block_settings.mobile_offset_horizontal }}%)) !important;
        {% elsif block_settings.mobile_horizontal_alignment == 'right' %}
          right: {{ block_settings.mobile_offset_right }}% !important;
        {% endif %}
        
        {% if block_settings.mobile_vertical_alignment == 'top' %}
          top: {{ block_settings.mobile_offset_top }}% !important;
        {% elsif block_settings.mobile_vertical_alignment == 'middle' %}
          top: 50% !important;
          {% if block_settings.mobile_horizontal_alignment == 'center' %}
            transform: translate(calc(-50% + {{ block_settings.mobile_offset_horizontal }}%), calc(-50% + {{ block_settings.mobile_offset_vertical }}%)) !important;
          {% else %}
            transform: translateY(calc(-50% + {{ block_settings.mobile_offset_vertical }}%)) !important;
          {% endif %}
        {% elsif block_settings.mobile_vertical_alignment == 'bottom' %}
          bottom: {{ block_settings.mobile_offset_bottom }}% !important;
        {% endif %}
      {% else %}
        /* Manual positioning for mobile */
        left: {{ block_settings.mobile_manual_left }}% !important;
        top: {{ block_settings.mobile_manual_top }}% !important;
      {% endif %}
    }

    .ai-overlay-slideshow-text-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-overlay-slideshow-button-{{ ai_gen_id }} {
      color: {{ block_settings.button_text_color | color_modify: 'alpha', 0.5 }} !important;
    }

  }

  @media screen and (orientation: landscape) and (max-height: 500px) {
    .ai-overlay-slideshow-container-{{ ai_gen_id }} {
      width: {{ block_settings.width }}% !important;
      height: 90% !important;
      left: 50% !important;
      right: auto !important;
      top: 50% !important;
      bottom: auto !important;
      transform: translate(-50%, -50%) !important;
    }

    .ai-overlay-slideshow-button-{{ ai_gen_id }} {
      color: {{ block_settings.button_text_color | color_modify: 'alpha', 0.5 }} !important;
    }
  }
{% endstyle %}

<overlay-slideshow-{{ ai_gen_id }}
  class="ai-overlay-slideshow-{{ ai_gen_id }}"
  data-autoplay="{{ block_settings.autoplay }}"
  data-autoplay-speed="{{ block_settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-overlay-slideshow-container-{{ ai_gen_id }}">
    <div class="ai-overlay-slideshow-wrapper-{{ ai_gen_id }}">
      <div class="ai-overlay-slideshow-slides-{{ ai_gen_id }}">
        {% if block_settings.collection != blank %}
          {% assign collection_products = block_settings.collection.products | limit: block_settings.max_slides %}
          
          {% if collection_products.size > 0 %}
            {% for product in collection_products %}
              <div
                class="ai-overlay-slideshow-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
              >
                <div class="ai-overlay-slideshow-image-container-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    {% liquid
                      assign height = product.featured_image.width | divided_by: product.featured_image.aspect_ratio | round
                      assign sizes = '(min-width: 750px) 30vw, 90vw'
                    %}
                    <img
                      srcset="{%- if product.featured_image.width >= 400 -%}{{ product.featured_image | image_url: width: 400 }} 400w,{%- endif -%}
                        {%- if product.featured_image.width >= 600 -%}{{ product.featured_image | image_url: width: 600 }} 600w,{%- endif -%}
                        {%- if product.featured_image.width >= 800 -%}{{ product.featured_image | image_url: width: 800 }} 800w,{%- endif -%}
                        {%- if product.featured_image.width >= 1000 -%}{{ product.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                        {%- if product.featured_image.width >= 1200 -%}{{ product.featured_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                        {{ product.featured_image | image_url }} {{ product.featured_image.width }}w"
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      sizes="{{ sizes }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-overlay-slideshow-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ height }}"
                    >
                  {% else %}
                    <div class="ai-overlay-slideshow-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if block_settings.show_overlay %}
                    <div class="ai-overlay-slideshow-overlay-{{ ai_gen_id }}"></div>
                  {% endif %}

                  <div class="ai-overlay-slideshow-content-{{ ai_gen_id }}">
                    <div class="ai-overlay-slideshow-text-wrapper-{{ ai_gen_id }}">
                      {% if block_settings.show_product_title %}
                        <h2 class="ai-overlay-slideshow-heading-{{ ai_gen_id }}">{{ product.title }}</h2>
                      {% endif %}
                      {% if block_settings.show_product_price %}
                        <div class="ai-overlay-slideshow-description-{{ ai_gen_id }}">{{ product.price | money }}</div>
                      {% endif %}
                      {% if block_settings.show_button %}
                        <a
                          href="{{ product.url }}"
                          class="ai-overlay-slideshow-button-{{ ai_gen_id }}"
                          style="color: {{ block_settings.button_text_color | color_modify: 'alpha', 0.3 }};"
                        >
                          {{ block_settings.button_text }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="ai-overlay-slideshow-slide-{{ ai_gen_id }} active">
              <div class="ai-overlay-slideshow-image-container-{{ ai_gen_id }}">
                <div class="ai-overlay-slideshow-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                  <div class="ai-overlay-slideshow-empty-state-{{ ai_gen_id }}">
                    The selected collection has no products
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% else %}
          <div class="ai-overlay-slideshow-slide-{{ ai_gen_id }} active">
            <div class="ai-overlay-slideshow-image-container-{{ ai_gen_id }}">
              <div class="ai-overlay-slideshow-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
                <div class="ai-overlay-slideshow-empty-state-{{ ai_gen_id }}">
                  Select a collection to display products
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      {% if block_settings.show_arrows and block_settings.collection != blank and collection_products.size > 1 %}
        <div class="ai-overlay-slideshow-arrows-{{ ai_gen_id }}">
          <button
            class="ai-overlay-slideshow-arrow-{{ ai_gen_id }} ai-overlay-slideshow-prev-{{ ai_gen_id }}"
            aria-label="Previous slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12.5 15L7.5 10L12.5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            class="ai-overlay-slideshow-arrow-{{ ai_gen_id }} ai-overlay-slideshow-next-{{ ai_gen_id }}"
            aria-label="Next slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7.5 15L12.5 10L7.5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      {% endif %}

      {% if block_settings.show_dots and block_settings.collection != blank and collection_products.size > 1 %}
        <div class="ai-overlay-slideshow-controls-{{ ai_gen_id }}">
          {% for product in collection_products %}
            <button
              class="ai-overlay-slideshow-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</overlay-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class OverlaySlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-overlay-slideshow-slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-overlay-slideshow-dot-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-overlay-slideshow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-overlay-slideshow-next-{{ ai_gen_id }}');
        
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        this.setupEventListeners();
        
        if (this.autoplay && this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }

        if (this.autoplay) {
          this.resetAutoplay();
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('overlay-slideshow-{{ ai_gen_id }}', OverlaySlideshow{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Overlay slideshow",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_slides",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Maximum slides",
      "default": 5
    },
    {
      "type": "header",
      "content": "⚙️ Desktop positioning"
    },
    {
      "type": "paragraph",
      "content": "Control how the slideshow is positioned on desktop screens"
    },
    {
      "type": "select",
      "id": "position_mode",
      "label": "Position mode",
      "options": [
        {
          "value": "alignment",
          "label": "Alignment (recommended)"
        },
        {
          "value": "manual",
          "label": "Manual (advanced)"
        }
      ],
      "default": "alignment",
      "info": "Alignment mode: position relative to edges. Manual mode: exact pixel positioning"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "header",
      "content": "Desktop fine-tuning"
    },
    {
      "type": "range",
      "id": "offset_left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Offset from left",
      "default": 0,
      "info": "For left alignment"
    },
    {
      "type": "range",
      "id": "offset_right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Offset from right",
      "default": 0,
      "info": "For right alignment"
    },
    {
      "type": "range",
      "id": "offset_top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Offset from top",
      "default": 0,
      "info": "For top alignment"
    },
    {
      "type": "range",
      "id": "offset_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Offset from bottom",
      "default": 0,
      "info": "For bottom alignment"
    },
    {
      "type": "range",
      "id": "offset_horizontal",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Horizontal nudge",
      "default": 0,
      "info": "For center alignment - shift left (-) or right (+)"
    },
    {
      "type": "range",
      "id": "offset_vertical",
      "min": -20,
      "max": 20,
      "step": 0.5,
      "unit": "%",
      "label": "Vertical nudge",
      "default": 0,
      "info": "For middle alignment - shift up (-) or down (+)"
    },
    {
      "type": "header",
      "content": "Desktop manual positioning"
    },
    {
      "type": "range",
      "id": "manual_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Left position",
      "default": 0,
      "info": "Only used in manual mode"
    },
    {
      "type": "range",
      "id": "manual_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Top position",
      "default": 0,
      "info": "Only used in manual mode"
    },
    {
      "type": "header",
      "content": "📱 Mobile positioning"
    },
